# =====================================================================
# MboaTech — variables d'environnement de production
# Copier vers /etc/mboa-tech/mboa-tech.env (root, chmod 600), puis
# renseigner chaque valeur. Ne jamais committer ce fichier réel.
# =====================================================================

# --- Base de données (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mboatech
DB_USERNAME=mboatech_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Mode SSL du pilote JDBC (prefer : SSL si le serveur le propose, sinon clair).
# Mettre à "require" si PostgreSQL n'est pas sur la même machine.
DB_SSL_MODE=prefer

# --- Compte administrateur initial ---
# Créé automatiquement au démarrage s'il n'existe aucun admin.
ADMIN_EMAIL=admin@mboatech.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Origines autorisées (CORS, HTTP + WebSocket) ---
# Liste de domaines séparés par des virgules.
CORS_ALLOWED_ORIGINS=https://mboatech.com,https://www.mboatech.com

# --- Backend ---
SERVER_PORT=8082
LOG_DIR=/opt/mboa-tech/logs

# --- Fichiers ---
UPLOAD_DIR=/opt/mboa-tech/uploads
PRIVATE_UPLOAD_DIR=/opt/mboa-tech/private-uploads

# --- Paiements « HR-Skills Pay » ---
# SIMULATION (par défaut) : aucune clé requise, transactions simulées.
HRSK_ENABLED=false
# Plateforme HR-Skills Pay : délivre 2 clés (clé publique A hrsk_pk_… + clé secrète B hrsk_sk_…).
HRSK_API_KEY=
HRSK_API_SECRET=
# Secret de signature des webhooks (header X-Hub-Signature).
HRSK_WEBHOOK_SECRET=
# Base URL de l'API HR-Skills Pay (production LIVE comme sandbox).
HRSK_API_BASE=https://api.hrskills-pay.com
# Pays (ISO 3166-1 alpha-2) et devise (ISO 4217) du payeur par défaut.
HRSK_COUNTRY=CM
HRSK_CURRENCY=XAF
HRSK_RETURN_URL=https://mboatech.com
HRSK_CANCEL_URL=https://mboatech.com
HRSK_WEBHOOK_URL=https://mboatech.com/api/payments/webhook

# --- Garde-fous missions (optionnel, défauts ci-dessous) ---
# MISSIONS_MAX_CONCURRENT=3
# MISSIONS_RESERVATION_HOURS=24
# MISSIONS_RESERVATION_CRITIQUE_HOURS=1
# MISSIONS_RESERVATION_IMPORTANT_HOURS=4
# MISSIONS_RESERVATION_NORMAL_HOURS=8
# MISSIONS_MAX_DECLINES=3
# MISSIONS_DECLINES_WINDOW_HOURS=24
