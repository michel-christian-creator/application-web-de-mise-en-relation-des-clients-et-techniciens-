[Unit]
Description=MboaTech Spring Boot backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=mboatech
Group=mboatech
WorkingDirectory=/opt/mboa-tech
# Les secrets (DB, admin, passerelle de paiement) vivent dans /etc/mboa-tech/mboa-tech.env
# (propriétaire root, permissions 600) — jamais dans le dépôt.
EnvironmentFile=/etc/mboa-tech/mboa-tech.env
ExecStart=/usr/bin/java -Xmx512m -jar /opt/mboa-tech/backend.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# Durcissement de base.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mboa-tech/uploads /opt/mboa-tech/private-uploads /opt/mboa-tech/logs

[Install]
WantedBy=multi-user.target
