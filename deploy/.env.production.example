# =====================================================================
# MboaTech — variables de build du frontend (Vite)
# Copier en `.env.production` à la racine du projet puis lancer :
#   npm run build
# Ces valeurs sont embarquées dans les fichiers statiques à la compilation.
# =====================================================================

# URL publique de l'API (nginx sert /api et /ws sur le même domaine).
# En mode "même origine" (recommandé avec le proxy nginx fourni), mettre
# simplement l'origine du site :
VITE_API_URL=https://mboatech.com

# Facultatif : URL WebSocket explicite (dérivée de VITE_API_URL sinon).
# VITE_API_WS_BASE=wss://mboatech.com
