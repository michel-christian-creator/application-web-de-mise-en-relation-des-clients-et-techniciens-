# Variables backend uniquement — ne jamais les exposer côté client.
# Clés API HR-Skills Pay (clé publique A + clé secrète B) fournies par la plateforme.
HRSK_API_KEY=remplacez-par-votre-cle-publique-hrsk_pk_
HRSK_API_SECRET=remplacez-par-votre-cle-secrete-hrsk_sk_
# Base URL de l'API HR-Skills Pay (production LIVE comme sandbox).
HRSK_API_BASE=https://api.hrskills-pay.com
# Pays (ISO 3166-1 alpha-2) et devise (ISO 4217) du payeur par défaut.
HRSK_COUNTRY=CM
HRSK_CURRENCY=XAF
# Webhook secret — à renseigner si la passerelle doit vérifier X-Hub-Signature.
HRSK_WEBHOOK_SECRET=
